<Bindings>
    <!--
        WoW 会自动从插件根目录加载本文件，不需要（也不应该）在 TOC 里声明。
        动作名 BIAOGE 与以下三处必须严格一致，否则设置面板的绑定控件读不到键、键也不会生效：
          Core/DB/Init2.lua   BINDING_HEADER_BIAOGE / BINDING_NAME_BIAOGE  —— 提供分类名与显示名
          Core/Options.lua    O.CreateBindKey(..., "BIAOGE", L["表格快捷键"]) —— 面板内的绑定控件
        BGNEXT_ROLE_OVERVIEW 是独立于 BIAOGE 的角色总览绑定，显示名来自本地化字符串
        「打开/关闭角色总览」，只调用角色总览的公开切换入口；不可用或禁用时静默无操作。
    -->
    <Binding name="BIAOGE" Category="BINDING_HEADER_BIAOGE">
        if BG and BG.MainFrame then BG.MainFrame:SetShown(not BG.MainFrame:IsVisible()) end
    </Binding>
    <Binding name="BGNEXT_ROLE_OVERVIEW" Category="BINDING_HEADER_BIAOGE">
        if BG and BG.BGNext and BG.BGNext.RoleOverviewEntry then BG.BGNext.RoleOverviewEntry.togglePinned() end
    </Binding>
</Bindings>
